# Salin file ini ke .env lalu isi nilainya. Nilai di bawah adalah contoh/default.

# Docker Compose defaults
POSTGRES_USER=sguard
POSTGRES_PASSWORD=sguard
POSTGRES_DB=sguard
FLOCI_IMAGE=floci/floci:latest

# Application runtime (wajib ganti JWT_SECRET)
DATABASE_URL=postgresql://sguard:sguard@localhost:5432/sguard
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
SYNC_MODE=stub
SYNC_TRANSPORT=local
EMAIL_VERIFICATION=false
MAIL_TRANSPORT=log
MAIL_FROM=SGuard <noreply@sguard.local>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
FRONTEND_ORIGIN=http://localhost:3000

# Shared rate limiting. Kosongkan untuk memakai penyimpanan memori (satu instance).
REDIS_URL=redis://localhost:6379

# Credential encryption / rotation.
# Legacy CREDENTIAL_ENCRYPTION_KEY (base64, 32 byte) dibaca sebagai id "default".
# Untuk rotasi: CREDENTIAL_ENCRYPTION_KEYS={"k1":"<base64 32 byte>","k2":"<base64 32 byte>"}
# dan CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=k2 (harus ada di CREDENTIAL_ENCRYPTION_KEYS).
# CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEYS=
CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=

# Optional integrations
# ALLOW_INSECURE_WEBHOOKS=false
# ALLOW_PRIVATE_WEBHOOKS=false
# SLACK_WEBHOOK_HOST=hooks.slack.com
# AWS_REGION=ap-southeast-1
# FLOCI_ENDPOINT=http://localhost:4566
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SCAN_INTERVAL_MINUTES=5
# SYNC_WORKER_HOST=127.0.0.1
# SYNC_WORKER_PORT=4000
# GITHUB_API_BASE=https://api.github.com
# GITHUB_OAUTH_BASE=https://github.com
# GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback
