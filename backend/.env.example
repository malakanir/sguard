# Salin ke backend/.env. Jangan commit file .env.
DATABASE_URL="postgresql://sguard:sguard@localhost:5432/sguard?schema=public"
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
JWT_EXPIRES_IN="15m"

# Sync ke Floci: floci (default) atau stub (untuk deployment server).
SYNC_MODE="floci"
FLOCI_ENDPOINT="http://localhost:4566"
AWS_REGION="us-east-1"

# sync-worker (FR-23): local = sinkronisasi di proses API, tcp = diteruskan ke sync-worker.
SYNC_TRANSPORT="local"
SYNC_WORKER_HOST="127.0.0.1"
SYNC_WORKER_PORT=4010

# Verifikasi email (FR-22). Nonaktif secara default.
EMAIL_VERIFICATION="false"
# smtp: kirim ke Mailpit (docker compose, port 1025). Selain itu: email ditulis ke log.
MAIL_TRANSPORT="log"
MAIL_FROM="SGuard <noreply@sguard.local>"
SMTP_HOST="127.0.0.1"
SMTP_PORT=1025

# Login GitHub (FR-21). Kosongkan GITHUB_CLIENT_ID untuk menonaktifkan.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:4000/auth/github/callback"

# Scan drift terjadwal (FR-25). 0 menonaktifkan.
SCAN_INTERVAL_MINUTES=0

# Kunci enkripsi kredensial AWS dan secret notifikasi: 32 byte dalam base64.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=""

# Hanya untuk pengembangan lokal: izinkan webhook http dan alamat privat.
ALLOW_INSECURE_WEBHOOKS="false"
ALLOW_PRIVATE_WEBHOOKS="false"

FRONTEND_ORIGIN="http://localhost:3000"
PORT=4000
